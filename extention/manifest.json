
{
  "manifest_version": 3,
  "name": "YouTube Sentiment Insights",
  "version": "2.0.0",
  "description": "Analyze YouTube comments using machine learning",

  "action": {
    "default_title": "Sentiment AI",
    "default_popup": "popup.html"
  },

  "permissions": [
    "activeTab"
  ],

  "host_permissions": [
    "http://127.0.0.1:5001/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}